# Copy this file to .env.local and fill in the values from your Supabase
# project dashboard: Project Settings → API.
#
#   cp .env.local.example .env.local
#
# .env.local is git-ignored. Never commit real keys.

# Project URL, e.g. https://abcdefghijklmn.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The client-side key. Newer projects call this the "publishable" key; older
# ones call it "anon". Either name works — set whichever your dashboard shows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Server-only secret used for admin scripts that must bypass RLS.
# NEVER prefix this with NEXT_PUBLIC_ and never expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin for Open Graph image URLs, canonical tags and the sitemap.
# Optional on Vercel: it falls back to VERCEL_PROJECT_PRODUCTION_URL, which is
# your production domain (and becomes your custom domain once you attach one).
# Set it only to name a domain not yet pointed at Vercel, or to deploy
# elsewhere. No trailing slash.
# e.g. https://rudragurujisevatrust.org
NEXT_PUBLIC_SITE_URL=
